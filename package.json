{
  "name": "obsidian-docs-sync",
  "version": "0.1.0",
  "description": "Safely sync an Obsidian vault through a private GitHub repository.",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:release": "node scripts/verify-release.mjs",
    "install:test": "node scripts/install-local.mjs .test-vaults/device-a .test-vaults/device-b",
    "install:main": "node scripts/install-local.mjs /Users/mrblacklu/文档/obsidian_notes"
  },
  "keywords": [
    "obsidian",
    "github",
    "sync"
  ],
  "author": "luhaifeng666",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luhaifeng666/obsidian-docs-sync.git"
  },
  "bugs": {
    "url": "https://github.com/luhaifeng666/obsidian-docs-sync/issues"
  },
  "homepage": "https://github.com/luhaifeng666/obsidian-docs-sync#readme",
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^24.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.31.0",
    "globals": "^16.3.0",
    "obsidian": "^1.13.1",
    "prettier": "^3.6.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vitest": "^4.1.10"
  }
}
